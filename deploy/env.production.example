# 弈星纪元兽装工作室官网 — 生产环境变量模板
#
# 复制为 server/.env 并填入真实值。绝不提交任何真实密钥。
# 生产启动时 app/platform/config.py 会校验下列组合，不安全即拒绝启动（fail closed）。

# ---- 模式与站点 ----
APP_ENV=production
PUBLIC_ORIGIN=https://starium.cn
SITE_NAME=弈星纪元兽装工作室
LEGAL_ENTITY=弈星纪元（上海）文化发展有限公司
BRAND_DOMAIN=starium.cn
SUPPORT_EMAIL=support@starium.cn
DEFAULT_LOCALE=zh-CN
DEFAULT_CURRENCY=CNY
TIMEZONE_DISPLAY=Asia/Shanghai

# ---- 数据库与数据目录（必须绝对路径、持久本地 SSD，禁止 NFS/网盘/对象存储挂载）----
DATA_DIR=/var/lib/starium
DATABASE_URL=sqlite+pysqlite:////var/lib/starium/starium.db
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_SYNCHRONOUS=FULL
DB_ECHO=false

# ---- 密钥（各自独立、≥32 字节、安全注入与轮换；不要使用示例值）----
SESSION_SECRET=
CSRF_SECRET=
OTP_SECRET=
PHONE_LOOKUP_KEY=
PII_ENCRYPTION_KEY=
PII_ENCRYPTION_KEY_VERSION=v1
SESSION_ABSOLUTE_HOURS=168
SESSION_IDLE_HOURS=24
SENSITIVE_REAUTH_MINUTES=10
COOKIE_SECURE=true

# ---- 员工后台 ----
ADMIN_SESSION_HOURS=8
MFA_ISSUER=Starium Admin

# ---- 短信（C03/C05：通道随云厂商切换）----
SMS_ADAPTER=aliyun
SMS_SIGN_NAME=弈星纪元
SMS_TEMPLATE_CODE=
SMS_SENDER_EMAIL=no-reply@starium.cn
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_PHONE_HOURLY_LIMIT=5
OTP_PHONE_DAILY_LIMIT=10
OTP_IP_HOURLY_LIMIT=20
OTP_DAILY_BUDGET=2000

# ---- 支付（C04：微信 + 支付宝 + PayPal + 信用卡；当前无商户号时保持开关关闭）----
PAYMENT_PROVIDERS=
PAYMENT_RETURN_URL=https://starium.cn/payment/return
WECHAT_MERCHANT_ID=
WECHAT_APP_ID=
WECHAT_API_V3_KEY=
WECHAT_PLATFORM_CERT_SERIAL=
ALIPAY_APP_ID=
ALIPAY_PUBLIC_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_WEBHOOK_ID=
INSTALLMENT_PAYMENT_TTL_MINUTES=30

# ---- 存储（生产必须对象存储 + CDN；私有桶禁止匿名读）----
STORAGE_BACKEND=s3
STORAGE_PUBLIC_PREFIX=public
STORAGE_PRIVATE_PREFIX=private
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET_PUBLIC=
STORAGE_S3_BUCKET_PRIVATE=
SIGNED_URL_TTL_SECONDS=60
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_FILES=3
UPLOAD_MAX_EDGE=8192
UPLOAD_MAX_PIXELS=40000000

# ---- 业务默认值（可在后台 /admin/settings 调整，不必改环境变量）----
DEFAULT_PREPAYMENT_PERCENT=50
QUOTE_VALID_DAYS=7
SLOT_HOLD_MINUTES=30
BALANCE_DUE_DAYS=7
FREE_REVISION_COUNT=2
POINTS_PER_CURRENCY_UNIT=5
POINTS_RELEASE_DELAY_DAYS=7
FEEDBACK_REWARD_MINOR=5
FEEDBACK_REWARD_NORMAL=20
FEEDBACK_REWARD_MAJOR=50
FEEDBACK_DAILY_REWARD_LIMIT=1

# ---- 功能开关（商业门槛未落实时保持 false）----
FEATURE_ONLINE_PAYMENT=false
FEATURE_POINTS_REDEMPTION=false
FEATURE_COUPONS=false
FEATURE_RUSH_ROUNDS=false
FEATURE_CLIENT_STORIES=false
FEATURE_EVENTS=false
FEATURE_EN_LOCALE=false
FEATURE_MARKETING_EMAIL=false

# ---- 运维 ----
OUTBOX_POLL_SECONDS=2
OUTBOX_LEASE_SECONDS=120
OUTBOX_MAX_ATTEMPTS=8
WORKER_CONCURRENCY=1
LOG_LEVEL=INFO
TRUSTED_PROXY_IPS=127.0.0.1
