# 开发环境配置模板（复制为 `server/` 下的环境文件后按需修改）
#
# 说明：本文件是模板，仅供开发与联调使用。真实密钥绝不提交；
# 生产配置模板在 `deploy/env.production.example`。
# 命名不带点前缀是为了通过仓库的敏感文件名拦截规则，使用时复制为
# `server/.env`（该文件已加入 .gitignore）。

APP_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:5173
SITE_NAME=弈星纪元兽装工作室
LEGAL_ENTITY=弈星纪元（上海）文化发展有限公司
BRAND_DOMAIN=starium.cn
SUPPORT_EMAIL=support@starium.cn
DEFAULT_LOCALE=zh-CN
DEFAULT_CURRENCY=CNY

# SQLite 放在应用主机的持久本地磁盘上；开发即仓库内的 server/var。
DATA_DIR=var
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_SYNCHRONOUS=FULL

# 开发环境留空：platform.config 会在进程内派生稳定密钥，不落盘、不写日志。
SESSION_SECRET=
CSRF_SECRET=
OTP_SECRET=
PHONE_LOOKUP_KEY=
PII_ENCRYPTION_KEY=
COOKIE_SECURE=false

# 沙盒适配器：短信写入 var/storage/sandbox/sms.log，支付不调用任何真实服务商。
# 生产环境使用 mock 适配器会被配置校验直接拒绝（fail closed）。
SMS_ADAPTER=mock
PAYMENT_PROVIDERS=mock
STORAGE_BACKEND=local

# 功能开关默认关闭；商业门槛（C01/C03–C06/C08/C10/C13/C14/C17/C19/C21/C22/C25/C26）
# 未落实时保持关闭，入口隐藏且后端拒绝。
FEATURE_ONLINE_PAYMENT=false
FEATURE_POINTS_REDEMPTION=false
FEATURE_COUPONS=false
FEATURE_RUSH_ROUNDS=false
FEATURE_CLIENT_STORIES=false
FEATURE_EVENTS=false
FEATURE_EN_LOCALE=false
FEATURE_MARKETING_EMAIL=false

OUTBOX_POLL_SECONDS=2
LOG_LEVEL=INFO
TRUSTED_PROXY_IPS=127.0.0.1
